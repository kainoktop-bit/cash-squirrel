# APP_URL: The production URL where this app is hosted (e.g. https://cash-squirrel.vercel.app),
# no trailing slash. Used by api/_lineAssistant.ts to build LINE Quick Reply deep links into the
# app itself -- ?job=<id> opens a saved job, ?openAddJob=1 / ?openAddExpense=1 pop the real
# add-job/add-expense modal straight open (all handled in src/App.tsx). Not a secret.
APP_URL="MY_APP_URL"

# Stripe subscription (server-side only, used by /api functions -- never expose in client code)
# Test mode keys start with sk_test_ ; switch to live keys only after end-to-end testing
# The Pro plan checkout itself is a Stripe Payment Link (see PRO_PAYMENT_LINK in src/App.tsx),
# these keys are only used to verify the webhook and open the Billing Portal
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Supabase service role key (server-only, bypasses Row Level Security)
# From Supabase project settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=""

# Overdue-payment digest + monthly report crons (server-side only, used by
# api/send-overdue-digest.ts and api/send-monthly-report.ts)
# GMAIL_USER / GMAIL_APP_PASSWORD send email via Gmail SMTP (App Password, not your login
# password -- generate one at myaccount.google.com under Security > 2-Step Verification)
# CRON_SECRET is a random string you generate yourself -- Vercel Cron sends it back as
# "Authorization: Bearer <CRON_SECRET>" so the endpoint can reject any other caller
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
CRON_SECRET=""

# Optional LINE notifications, ad-hoc for a known set of recipients (not a per-user account
# link) -- used by api/_line.ts. LINE_CHANNEL_ACCESS_TOKEN and LINE_CHANNEL_SECRET both come
# from a LINE Official Account's Messaging API channel in the LINE Developers Console
# (Basic settings tab for the secret, Messaging API tab for the token). LINE_CHANNEL_SECRET
# is only used by api/line-webhook.ts, a one-time setup helper for finding your own LINE
# user ID -- message the bot and it replies with your ID. LINE_RECIPIENTS maps each
# app-user's email to their LINE user ID, comma-separated: "a@x.com:U123,b@y.com:U456"
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
LINE_RECIPIENTS=""

# LIFF add-record form (public/liff-add.html + api/liff-config.ts + api/liff-submit.ts) --
# a one-screen form for adding a job/expense, identity-verified straight from the LINE session
# (no separate app login, and no risk of saving to whatever account happens to be logged into
# the browser -- see the chat history for why that mattered). LIFF apps can no longer be added
# directly to a Messaging API channel -- create a separate LINE Login channel under the SAME
# Provider as the bot's Messaging API channel (User ID is only shared within one Provider),
# then add the LIFF app there (LIFF tab, Size: Full, Endpoint URL: "<APP_URL>/liff-add.html",
# Scope: openid).
# LINE_CHANNEL_ID: the numeric "Channel ID" from that LINE Login channel's Basic settings tab
# (NOT the Messaging API channel's ID) -- used server-side to verify the LIFF page's ID token.
# LIFF_ID: from that channel's LIFF tab. Not a secret (embedded in client JS), kept as an env
# var so it's changeable without editing the static HTML file.
LINE_CHANNEL_ID=""
LIFF_ID=""

# LINE assistant free-form Q&A (api/_lineAssistant.ts's answerFromData). Get a key at
# aistudio.google.com/apikey. Optional -- if unset, free-form questions in LINE just fall back
# to the static greeting/buttons (Quick Reply commands work either way, zero AI cost).
GEMINI_API_KEY=""
