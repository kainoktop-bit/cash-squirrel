rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserCashflowData(data) {
      return data.userId is string 
          && data.userId.size() <= 128
          && (data.email == null || (data.email is string && data.email.size() <= 256));
    }

    // Main user collection
    match /user_cashflow_data/{userId} {
      allow get, delete: if isOwner(userId) && isValidId(userId);
      
      allow create: if isOwner(userId) 
                    && isValidId(userId)
                    && isValidUserCashflowData(incoming())
                    && incoming().userId == request.auth.uid;
                    
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUserCashflowData(incoming())
                    && incoming().userId == existing().userId;
    }
  }
}
